{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove:*)",
      "Bash(gh pr merge:*)",
      "Bash(vercel)",
      "Bash(npx vercel)",
      "Bash(vercel --prod:*)",
      "Bash(npx vercel --prod:*)",
      "Bash(vercel deploy:*)",
      "Bash(npx vercel deploy:*)",
      "Bash(vercel promote:*)",
      "Bash(npx vercel promote:*)",
      "Bash(vercel env rm:*)",
      "Bash(npx vercel env rm:*)",
      "Bash(vercel project rm:*)",
      "Bash(npx vercel project rm:*)",
      "Bash(npm run eval:live:*)",
      "Bash(rm -rf:*)"
    ],
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run features:*)",
      "Bash(npm run eval)",
      "Bash(npx tsc:*)",
      "Bash(node scripts/features.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree add:*)",
      "Bash(npx vercel ls:*)",
      "Bash(npx vercel inspect:*)",
      "Bash(ls:*)"
    ]
  }
}
